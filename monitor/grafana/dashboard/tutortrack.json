{
  "title": "TutorTrack - API & Business Metrics",
  "uid": "tutortrack-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request rate by tenant",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (tenant) (rate(tutortrack_tenant_requests_total[5m]))",
          "legendFormat": "{{tenant}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "5xx error rate by tenant",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (tenant) (rate(tutortrack_tenant_requests_total{status_code=~\"5..\"}[5m]))",
          "legendFormat": "{{tenant}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Request latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "title": "Sessions booked vs. booking conflicts (by tenant)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (tenant) (rate(tutortrack_sessions_booked_total[15m]))",
          "legendFormat": "booked: {{tenant}}"
        },
        {
          "expr": "sum by (tenant) (rate(tutortrack_booking_conflicts_total[15m]))",
          "legendFormat": "conflicts: {{tenant}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Key Vault secret fetch latency (cache misses)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(tutortrack_keyvault_secret_fetch_seconds_bucket[15m])) by (le, tenant))",
          "legendFormat": "p95: {{tenant}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Unknown-tenant requests (possible misconfigured client or probing)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "rate(tutortrack_tenant_resolution_failures_total[5m])",
          "legendFormat": "resolution failures/sec"
        }
      ]
    }
  ]
}