# Copy to .env for local development. Every field maps 1:1 to
# app/config.py - see that file for what each one does.

ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false

# Off locally so you can curl the API with zero setup. Set true in any
# real deployment - see terraform/modules/monitoring for how this gets
# switched on for staging/prod via Container Apps env vars.
REQUIRE_API_KEY=false

# Leave unset locally to use `az login` via DefaultAzureCredential.
# Set only inside Azure Container Apps (Terraform injects this).
APP_IDENTITY_CLIENT_ID=

# Leave unset to export traces to the console instead of Azure Monitor.
APPLICATIONINSIGHTS_CONNECTION_STRING=

ENABLE_TRACING=true
ENABLE_METRICS=true
OTEL_SERVICE_NAME=tutortrack-api

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

TESTING=false
